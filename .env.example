# =============================================================================
# Trulab Viajes — variables de entorno
# Copiar a `.env` (no versionado) y completar. Nunca poner secretos reales aquí.
# Las tareas que consumen cada bloque se indican entre corchetes.
# =============================================================================

# --- Docker Compose [S1-02] ----------------------------------------------------
# Permite ejecutar `docker compose ...` desde la raíz usando infra/docker-compose.yml.
COMPOSE_FILE=infra/docker-compose.yml
# Puertos publicados en 127.0.0.1 (cambiarlos si ya están ocupados en el equipo).
# La BD usa 5433 para no chocar con un PostgreSQL instalado en Windows (que suele usar 5432).
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- General -----------------------------------------------------------------
# local | staging | production. El login de desarrollo solo existe con ENV=local (R1.1).
ENV=local
LOG_LEVEL=INFO

# --- Base de datos PostgreSQL 16 [S1-02, S1-04] --------------------------------
# Tres roles con privilegios mínimos (docs/database-design.md §6, infra/README.md):
#   postgres     superusuario de arranque: solo inicializa y administra (nunca la app).
#   trulab_owner dueño de la BD y del esquema; ejecuta las migraciones (servicio `migrate`).
#   trulab_app   la API: solo DML, sin DDL ni BYPASSRLS y sin ser dueño de nada.
# Contraseñas distintas para cada rol. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Si cambian después de crear el volumen: docker compose exec db bash /docker-entrypoint-initdb.d/10-roles.sh
POSTGRES_DB=trulab_viajes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
OWNER_DB_USER=trulab_owner
OWNER_DB_PASSWORD=
APP_DB_USER=trulab_app
APP_DB_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alembic (servicio `migrate`) con trulab_owner; la contraseña es OWNER_DB_PASSWORD.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://trulab_owner:CAMBIAR@db:5432/trulab_viajes
# La API con trulab_app; la contraseña es APP_DB_PASSWORD.
DATABASE_URL=postgresql+psycopg://trulab_app:CAMBIAR@db:5432/trulab_viajes

# --- Autenticación (DP-01: solo Google Workspace de Trulab) [S1-08] -----------
GOOGLE_CLIENT_ID=
# Dominio exigido en el claim `hd` del ID token.
GOOGLE_WORKSPACE_DOMAIN=trulab.co
# Secreto HS256 del access token; generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Primer SUPERADMIN [S1-07]. El servicio `migrate` lo crea tras las migraciones solo si no hay
# ningún SUPERADMIN activo (idempotente; si el correo ya existe, lo promueve y reactiva). Debe ser
# del dominio GOOGLE_WORKSPACE_DOMAIN. Vacío = no se crea. Los demás usuarios, desde la app (S1-10).
SUPERADMIN_EMAIL=
SUPERADMIN_NOMBRE=Superadministrador

# --- API [S1-03] ---------------------------------------------------------------
# Origen permitido por CORS (la SPA). En local no se usa: la SPA llama a la API por el proxy de Vite.
CORS_ORIGINS=http://localhost:5173

# --- Almacenamiento de soportes y archivos (DP-05) [F5] ------------------------
# local | s3 | gcs. En desarrollo: local (en Docker se guarda en el volumen api-storage).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
# Solo para STORAGE_BACKEND=s3 (producción, según DP-05).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
SIGNED_URL_TTL_SECONDS=300

# --- Frontend (Vite expone solo las variables VITE_*) [S1-05] ------------------
# Todo VITE_* termina en el JavaScript del navegador: nunca poner secretos aquí.
# Base de la API. `/api/v1` = misma origen: en desarrollo el servidor de Vite reenvía `/api` al
# servicio `api` (frontend/vite.config.ts), así no hace falta CORS en local. Una URL absoluta
# (otra origen) exige configurar CORS en la API (CORS_ORIGINS).
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=
