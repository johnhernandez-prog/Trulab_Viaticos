# =============================================================================
# Trulab Viajes — variables de entorno
# Copiar a `.env` (no versionado) y completar. Nunca poner secretos reales aquí.
# Las tareas que consumen cada bloque se indican entre corchetes.
# =============================================================================

# --- Docker Compose [S1-02] ----------------------------------------------------
# Permite ejecutar `docker compose ...` desde la raíz usando infra/docker-compose.yml.
COMPOSE_FILE=infra/docker-compose.yml
# Puertos publicados en 127.0.0.1 (cambiarlos si ya están ocupados en el equipo).
# La BD usa 5433 para no chocar con un PostgreSQL instalado en Windows (que suele usar 5432).
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- General -----------------------------------------------------------------
# local | staging | production. El login de desarrollo solo existe con ENV=local (R1.1).
ENV=local
LOG_LEVEL=INFO

# --- Base de datos PostgreSQL 16 [S1-02, S1-04] --------------------------------
POSTGRES_DB=trulab_viajes
POSTGRES_USER=trulab_owner
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Rol sin BYPASSRLS con el que se conecta la API (docs/database-design.md §6).
APP_DB_USER=trulab_app
APP_DB_PASSWORD=
# trulab_owner: migraciones Alembic. trulab_app: la API.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://trulab_owner:CAMBIAR@db:5432/trulab_viajes
DATABASE_URL=postgresql+psycopg://trulab_app:CAMBIAR@db:5432/trulab_viajes

# --- Autenticación (DP-01: solo Google Workspace de Trulab) [S1-08] -----------
GOOGLE_CLIENT_ID=
# Dominio exigido en el claim `hd` del ID token.
GOOGLE_WORKSPACE_DOMAIN=trulab.co
# Secreto HS256 del access token; generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Primer SUPERADMIN que se crea en el seed [S1-07].
SUPERADMIN_EMAIL=

# --- API [S1-03] ---------------------------------------------------------------
# Origen permitido por CORS (la SPA).
CORS_ORIGINS=http://localhost:5173

# --- Almacenamiento de soportes y archivos (DP-05) [F5] ------------------------
# local | s3 | gcs. En desarrollo: local (en Docker se guarda en el volumen api-storage).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
# Solo para STORAGE_BACKEND=s3 (producción, según DP-05).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
SIGNED_URL_TTL_SECONDS=300

# --- Frontend (Vite expone solo las variables VITE_*) [S1-05] ------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
